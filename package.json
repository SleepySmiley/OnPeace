{
  "name": "onpeace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w @onpeace/server\" \"npm run dev -w @onpeace/client\"",
    "dev:client": "npm run dev -w @onpeace/client",
    "dev:server": "npm run dev -w @onpeace/server",
    "build": "npm run build -w @onpeace/client",
    "start": "npm run start -w @onpeace/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tools",
    "data:check": "tsx tools/check-data.ts",
    "data:schema": "tsx tools/write-schemas.ts",
    "postinstall": "tsx tools/cloudflared.ts --installa || exit 0",
    "tunnel": "tsx tools/cloudflared.ts tunnel --url http://localhost:3210",
    "serata": "tsx tools/serata.ts",
    "prova": "tsx tools/prova-generale.ts",
    "mondo": "tsx tools/mondo/territori.ts",
    "mondo:scarica": "tsx tools/mondo/scarica.ts",
    "mondo:anteprima": "tsx tools/mondo/anteprima.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
