{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "turn": {
      "type": "object",
      "properties": {
        "minSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "defaultSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "peaceTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "minSeconds",
        "maxSeconds",
        "defaultSeconds",
        "peaceTurns"
      ],
      "additionalProperties": false
    },
    "economy": {
      "type": "object",
      "properties": {
        "ownedStartPct": {
          "type": "number",
          "minimum": 0
        },
        "ownedGrowthPct": {
          "type": "number",
          "minimum": 0
        },
        "ownedNormalPct": {
          "type": "number",
          "minimum": 0
        },
        "ownedSlowGrowthPct": {
          "type": "number",
          "minimum": 0
        },
        "ownedCapPct": {
          "type": "number",
          "minimum": 0
        },
        "foreignStartPct": {
          "type": "number",
          "minimum": 0
        },
        "foreignGrowthPct": {
          "type": "number",
          "minimum": 0
        },
        "foreignCapPct": {
          "type": "number",
          "minimum": 0
        },
        "fullCountryBonusPct": {
          "type": "number",
          "minimum": 0
        },
        "upkeepDivisor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blockPurchasesWhenNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "ownedStartPct",
        "ownedGrowthPct",
        "ownedNormalPct",
        "ownedSlowGrowthPct",
        "ownedCapPct",
        "foreignStartPct",
        "foreignGrowthPct",
        "foreignCapPct",
        "fullCountryBonusPct",
        "upkeepDivisor",
        "blockPurchasesWhenNegative"
      ],
      "additionalProperties": false
    },
    "reinforcements": {
      "type": "object",
      "properties": {
        "cycleTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxPerCity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accumulate": {
          "type": "boolean"
        },
        "freeMilitiaOnCapture": {
          "type": "boolean"
        },
        "freeMilitiaUnit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "populationTable": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "minPopulation": {
                "type": "number",
                "minimum": 0
              },
              "reinforcements": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "minPopulation",
              "reinforcements"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cycleTurns",
        "maxPerCity",
        "accumulate",
        "freeMilitiaOnCapture",
        "freeMilitiaUnit",
        "populationTable"
      ],
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "properties": {
        "defenderWinsMutualKill": {
          "type": "boolean"
        },
        "healAfterBattle": {
          "type": "boolean"
        },
        "stackBonus": {
          "type": "boolean"
        },
        "defenceBonusAddsToMax": {
          "type": "boolean"
        }
      },
      "required": [
        "defenderWinsMutualKill",
        "healAfterBattle",
        "stackBonus",
        "defenceBonusAddsToMax"
      ],
      "additionalProperties": false
    },
    "turnblock": {
      "type": "object",
      "properties": {
        "alwaysBlockMaxUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "escapeFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "alwaysBlockMaxUnits",
        "escapeFactor"
      ],
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "properties": {
        "stackRange": {
          "type": "string",
          "enum": [
            "average",
            "minimum"
          ]
        },
        "defenceLineMaxDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "portMaxSeaDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "citySnapDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unloadMaxDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "stackRange",
        "defenceLineMaxDistance",
        "portMaxSeaDistance",
        "citySnapDistance",
        "unloadMaxDistance"
      ],
      "additionalProperties": false
    },
    "diplomacy": {
      "type": "object",
      "properties": {
        "peaceToWarTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allianceToWarTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxAlliances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "peaceToWarTurns",
        "allianceToWarTurns",
        "maxAlliances"
      ],
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "properties": {
        "collateralCapPct": {
          "type": "number",
          "minimum": 0
        },
        "recoveryPctPerTurn": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "collateralCapPct",
        "recoveryPctPerTurn"
      ],
      "additionalProperties": false
    },
    "neutrals": {
      "type": "object",
      "properties": {
        "militiaPerReinforcement": {
          "type": "number",
          "minimum": 0
        },
        "infantryMinCountryIncome": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "infantryUnit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "infantryPerCity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "militiaPerReinforcement",
        "infantryMinCountryIncome",
        "infantryUnit",
        "infantryPerCity"
      ],
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "unitCostFactor": {
          "type": "number",
          "minimum": 0
        },
        "cityCaptured": {
          "type": "number",
          "minimum": 0
        },
        "capitalCaptured": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "unitCostFactor",
        "cityCaptured",
        "capitalCaptured"
      ],
      "additionalProperties": false
    },
    "stealth": {
      "type": "object",
      "properties": {
        "detectionFactor": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "detectionFactor"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "incomeFactor": {
          "type": "number",
          "minimum": 0
        },
        "reinforcementValue": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "incomeFactor",
        "reinforcementValue"
      ],
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "properties": {
        "startingFunds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "initialCountries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lateJoinUntilTurn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "countrySelectSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 9007199254740991
        },
        "disconnectGraceMinutes": {
          "type": "number",
          "minimum": 0
        },
        "kickAfterInactiveTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rareUnitChancePct": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "startingFunds",
        "initialCountries",
        "maxTurns",
        "lateJoinUntilTurn",
        "countrySelectSeconds",
        "disconnectGraceMinutes",
        "kickAfterInactiveTurns",
        "rareUnitChancePct"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "turn",
    "economy",
    "reinforcements",
    "combat",
    "turnblock",
    "movement",
    "diplomacy",
    "population",
    "neutrals",
    "scoring",
    "stealth",
    "selection",
    "game"
  ],
  "additionalProperties": false
}
