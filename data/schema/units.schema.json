{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "enum": [
              "land",
              "naval",
              "air"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "ground_main_attack",
              "ground_main_defence",
              "ground_secondary_defence",
              "ground_special_defence",
              "ground_stealth",
              "naval_main_attack",
              "naval_stealth",
              "naval_transport",
              "air_main_attack",
              "air_special_attack",
              "air_stealth",
              "air_support",
              "air_transport",
              "general",
              "rare",
              "other"
            ]
          },
          "attack": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "defence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "crit": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "move": {
            "type": "number",
            "minimum": 0
          },
          "view": {
            "type": "number",
            "minimum": 0
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "collateral": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stealth": {
            "default": false,
            "type": "boolean"
          },
          "canTakeCities": {
            "type": "boolean"
          },
          "transportable": {
            "default": false,
            "type": "boolean"
          },
          "cargo": {
            "type": "object",
            "properties": {
              "capacity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "carries": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "any_land"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                ]
              }
            },
            "required": [
              "capacity",
              "carries"
            ],
            "additionalProperties": false
          },
          "defenceBonus": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "value": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "vs",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "domain",
          "role",
          "attack",
          "defence",
          "crit",
          "hp",
          "move",
          "view",
          "cost",
          "canTakeCities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "units"
  ],
  "additionalProperties": false
}
