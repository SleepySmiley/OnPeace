{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "defence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "crit": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "view": {
            "type": "number",
            "minimum": 0
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "portOnly": {
            "default": false,
            "type": "boolean"
          },
          "defenceBonus": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "value": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "vs",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "effects": {
            "default": {},
            "type": "object",
            "properties": {
              "upkeepReduction": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "extraReinforcements": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cityDefenceBonus": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "defence",
          "crit",
          "hp",
          "view",
          "cost"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "buildings"
  ],
  "additionalProperties": false
}
