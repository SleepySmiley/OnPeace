{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rangeScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "countries": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capital": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "shape": {
            "minItems": 1,
            "type": "array",
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "capital",
          "shape"
        ],
        "additionalProperties": false
      }
    },
    "cities": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "population": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "income": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "port": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "country",
          "pos",
          "population",
          "income",
          "port"
        ],
        "additionalProperties": false
      }
    },
    "noGo": {
      "default": [],
      "type": "array",
      "items": {
        "minItems": 1,
        "type": "array",
        "items": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "shortcuts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "from": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "to": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "for": {
            "type": "string",
            "enum": [
              "land",
              "naval"
            ]
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "for"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "width",
    "height",
    "rangeScale",
    "countries",
    "cities"
  ],
  "additionalProperties": false
}
